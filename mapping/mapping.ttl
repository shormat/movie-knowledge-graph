        rml:source <#DB_source> ;
        rml:referenceFormulation ql:SQL ;
        rml:query "SELECT person.*, principal.title_id FROM person JOIN principal ON person.n_const = principal.n_const WHERE principal.category = 'composer'" ;
    ] ;
   rr:subjectMap [
       rr:template "http://ceribouchetiflor.be/resource/Person/{n_const}" ;
   ] ;
   rr:predicateObjectMap [
       rr:predicate movi:composedFor ;
       rr:objectMap [
           rr:parentTriplesMap <#Show> ;
              rr:joinCondition [
                rr:child "title_id" ;
                rr:parent "title_id" ;
              ] ;
         ] ;
    ] ;
.

