@prefix movi: <http://ceribouchetiflor.be/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://ceribouchetiflor.be/ontology#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#> .

<#DB_source> a d2rq:Database ;
    d2rq:jdbcDriver "com.mysql.jdbc.Driver" ;
    d2rq:jdbcDSN "jdbc:mysql://localhost:4269/ceribou-chetiflor" ;
    d2rq:username "root" ;
    d2rq:password "root" ;
.

<#Person>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source <#DB_source> ;
        rml:referenceFormulation ql:SQL ;
        rml:query "SELECT person.* , known_for.title_id FROM person JOIN known_for ON person.n_const = known_for.n_const" ;
    ] ;
    rr:subjectMap [
        rr:template "http://ceribouchetiflor.be/resource/Person/{n_const}" ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate movi:name ;
        rr:objectMap [ rml:reference "primaryName" ; rr:datatype xsd:string ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate movi:BirthYear ;
        rr:objectMap [ rml:reference "birthYear" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate movi:DeathYear ;
        rr:objectMap [ rml:reference "deathYear"  ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate movi:knownFor ;
        rr:objectMap [
            rr:parentTriplesMap <#Show> ;
            rr:joinCondition [
                rr:child "title_id" ;
                rr:parent "title_id" ;
            ] ;
        ] ;
    ] ;
.

<#Actor>
   a rr:TriplesMap ;
    rml:logicalSource [
        rml:source <#DB_source> ;
        rml:referenceFormulation ql:SQL ;
        rml:query "SELECT person.*, principal.title_id FROM person JOIN principal ON person.n_const = principal.n_const WHERE principal.category = 'actor'" ;
    ] ;
   rr:subjectMap [
       rr:template "http://ceribouchetiflor.be/resource/Person/{n_const}" ;
   ] ;
   rr:predicateObjectMap [
       rr:predicate movi:actedIn ;
       rr:objectMap [
           rr:parentTriplesMap <#Show> ;
              rr:joinCondition [
                rr:child "title_id" ;
                rr:parent "title_id" ;
              ] ;
         ] ;
    ] ;
.

