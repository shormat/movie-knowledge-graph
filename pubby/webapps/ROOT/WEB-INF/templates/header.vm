<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
  <head>
    <title>
#if ($head_title)
      $head_title
#else
      $title
#end
#if ($project_name)
      | $project_name
#end
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
#if ($rdf_link)
    <link rel="alternate" type="application/rdf+xml" href="$rdf_link" title="RDF" />
#end
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" type="text/css" href="${server_base}static/style.css?v=20250428" />
    <script type="text/javascript" src="${server_base}static/script.js?v=20250428"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  </head>
  <body onLoad="init();">
    <!-- Bootstrap navbar Header -->
    <nav id="header" class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="$server_base">$title</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
#if ($project_name)
    #if ($project_link)
            <li class="nav-item">
              <a class="nav-link" href="$project_link">$project_name</a>
            </li>
    #else
            <li class="nav-item">
              <a class="nav-link" href="$server_base">$project_name</a>
            </li>
    #end
#end
            <li class="nav-item">
              <a class="nav-link" href="http://endpoint.ceribouchetiflor.be/index.html" target="_blank" rel="noopener">SPARQL</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="http://faceted.ceribouchetiflor.be/fct" target="_blank" rel="noopener">Faceted Browser</a>
            </li>
          </ul>
#if ($uri)
          <span class="navbar-text text-light">
            <a class="text-light" href="$uri">$uri</a>
          </span>
#end
#if ($rdf_link)
          <a class="nav-link text-light ms-3" href="$rdf_link" title="RDF data">
            <img src="${server_base}static/rdf-icon.gif" alt="RDF" />
          </a>
#end
        </div>
      </div>
    </nav>

    <!-- Page content wrapper -->
    <div class="container my-4">
